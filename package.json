{
  "name": "@nomad/ui",
  "version": "1.5.1",
  "description": "Kit, tema (11 paletas), barra Nomad, camada de dados e presets compartilhados pelos apps da Nomad. Base: kit do AgentPack.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "github:PedroPaduelo/nomad-ui",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "presets",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/theme/theme.css",
    "./responsive.css": "./src/theme/responsive.css",
    "./markdown": {
      "types": "./dist/types/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./theme-boot": {
      "types": "./dist/types/lib/themeBoot.d.ts",
      "import": "./dist/theme-boot.js"
    },
    "./data": {
      "types": "./dist/types/data/index.d.ts",
      "import": "./dist/data.js"
    },
    "./topbar": {
      "types": "./dist/types/topbar/index.d.ts",
      "import": "./dist/topbar.js"
    },
    "./topbar.css": "./src/topbar/topbar.css",
    "./tsconfig": "./presets/tsconfig.json",
    "./eslint": "./presets/eslint.js",
    "./prettier": "./presets/prettier.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/showcase",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run -c vitest.a11y.config.ts",
    "gates": "npm run typecheck && npm run lint && npm test && npm run build",
    "showcase:dev": "vite --config examples/showcase/vite.config.ts",
    "showcase:build": "vite build --config examples/showcase/vite.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.103.2",
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.2",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react-markdown": {
      "optional": true
    }
  }
}
